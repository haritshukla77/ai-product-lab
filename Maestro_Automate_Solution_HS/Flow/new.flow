          "guardrails": {
            "type": "array"
          },
          "agentInputVariables": {
            "type": "array"
          },
          "agentOutputVariables": {
            "type": "array"
          }
        },
        "required": [
          "systemPrompt",
          "userPrompt",
          "model"
