          "maxTokenPerResponse": {
            "type": "number",
            "minimum": 0
          },
          "modelMaxTokens": {
            "type": "number",
            "minimum": 0
          },
          "maxIterations": {
            "type": "number",
            "minimum": 1,
            "maximum": 100
